+static void process_nl_message(struct nlmsghdr *nh) {
+	D(SYSTEM, "Message Type: %u\n", nh->nlmsg_type);
+	if ((nh->nlmsg_type == RTM_NEWROUTE)||(nh->nlmsg_type == RTM_DELROUTE)){
+		struct rtmsg *rtp= (struct rtmsg *) NLMSG_DATA(nh);
+		if(rtp->rtm_table == RT_TABLE_LOCAL) return; /* skip local route */
+		struct rtattr * rtap = (struct rtattr *) RTM_RTA(rtp);
+		int rtl = IFA_PAYLOAD(nh);
+		struct device_route route = {
+			.metric=0,
+			.enabled=true,
+			.source.in.s_addr=0,
+			.addr.in.s_addr=0,
+			.nexthop.in.s_addr=0,
+			.table=0,
+		};
+		unsigned index=0;
+
+		for(;RTA_OK(rtap, rtl);rtap=RTA_NEXT(rtap,rtl)) {
+			if (rtap->rta_type == RTA_PRIORITY)
+				route.metric=*((int *)RTA_DATA(rtap));
+			else if(rtap->rta_type == RTA_OIF)
+				index=*((int *)RTA_DATA(rtap));
+			else if(rtap->rta_type == RTA_SRC)
+				route.source.in.s_addr=((struct in_addr *)RTA_DATA(rtap))->s_addr;
+			else if(rtap->rta_type == RTA_DST)
+				route.addr.in.s_addr=((struct in_addr *)RTA_DATA(rtap))->s_addr;
+			else if(rtap->rta_type == RTA_GATEWAY)
+				route.nexthop.in.s_addr=((struct in_addr *)RTA_DATA(rtap))->s_addr;
+			else if(rtap->rta_type == RTA_TABLE)
+				route.table=*((int *)RTA_DATA(rtap));
+		}
+		if(nh->nlmsg_type == RTM_DELROUTE)route.enabled=false;
+		interface_set_metric(index, &route);
+	}
 
-	device_set_link(dev, link_state ? true : false);
+	if (nh->nlmsg_type == RTM_NEWLINK){
+		struct nlattr *nla[__IFLA_MAX];
+		int link_state = 0;
+		char buf[10];
+		nlmsg_parse(nh, sizeof(struct ifinfomsg), nla, __IFLA_MAX - 1, NULL);
+		if (!nla[IFLA_IFNAME])
+			return;
+
+		struct device *dev = device_find(nla_data(nla[IFLA_IFNAME]));
+		if (!dev)
+			return;
+
+		if (!system_get_dev_sysctl("/sys/class/net/%s/carrier", dev->ifname, buf, sizeof(buf)))
+			link_state = strtoul(buf, NULL, 0);
+		device_set_link(dev, link_state ? true : false);
+	}
+}
 
