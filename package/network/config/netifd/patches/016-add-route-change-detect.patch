+
+void
+interface_update_defaultroute(void)
+{
+	struct interface *iface;
+	struct device_route *defroute=NULL;
+	/* find the minimum default route and update
+	 * struct device_route *pdefaultroute;
+	 * If the interface changes, send a callback.
+	 */
+	int min_metric=INT_MAX;
+	vlist_for_each_element(&interfaces, iface, node) {
+		if(iface->state!=IFS_UP)continue; /* only interfaces that are up */
+		struct interface_ip_settings *ip=&iface->proto_ip; /* protocol routes first */
+		for(int i=0; i< 2; i++){
+			struct device_route *route;
+			vlist_for_each_element(&ip->route, route, node){
+				if(!route->iface)continue; /* probably means we havent finished setting it up */
+				if(route->table&&(route->table != RT_TABLE_MAIN)) continue; /* only main routing table */
+				if(route->addr.in.s_addr) continue; /* not default route */
+				if(!route->enabled) continue;
+				if(route->dynamic_metric_on){
+					if(min_metric<=route->dynamic_metric)continue;
+					min_metric=route->dynamic_metric;
+				} else {
+					if(min_metric<=route->metric)continue;
+					min_metric=route->metric;
 				}
-				if(pass++)break;
-				ip=&iface->config_ip;
+				defroute=route;
+				if(!min_metric) goto interface_update_defaultroute_change;
 			}
+			ip=&iface->config_ip; /* check config routes */
 		}
 	}
+
+interface_update_defaultroute_change:
+	if((pdefaultroute==defroute) && defroute && (defroute->iface==pdefaultroute->iface)) return; /* no change to default interface */
+
+	if(defroute){
+		netifd_log_message(L_NOTICE, "Default Route interface has changed to: %s, metric %d\n",
+						defroute->iface->name, min_metric);
+		interface_event(defroute->iface, IFEV_DEFAULTROUTE);
+	}
+	else if(pdefaultroute)
+		netifd_log_message(L_NOTICE, "Default Route Removed\n");
+	pdefaultroute=defroute;
+	return;
 }
 
