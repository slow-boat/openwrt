+int system_bond_addif(struct device *bond, struct device *dev){
+	struct ifreq ifrm, ifrs;
+
+	/* is it already a slave? */
+	memset(&ifrs, 0, sizeof(ifrs));
+	strncpy(ifrs.ifr_name, dev->ifname, sizeof(ifrs.ifr_name) - 1);
+	if (ioctl(sock_ioctl, SIOCGIFFLAGS, &ifrs) < 0)
+		return -errno;
+
+	if(!(ifrs.ifr_flags & IFF_SLAVE)) {
+		if(ifrs.ifr_flags & IFF_UP){
+			ifrs.ifr_flags &=~IFF_UP;
+			if (ioctl(sock_ioctl, SIOCSIFFLAGS, &ifrs) < 0)
+				return -errno;
+		}
+		memset(&ifrm, 0, sizeof(ifrm));
+		strncpy(ifrm.ifr_name, bond->ifname, sizeof(ifrm.ifr_name) - 1);
+		strncpy(ifrm.ifr_slave, dev->ifname, sizeof(ifrm.ifr_slave) - 1);
+		if (ioctl(sock_ioctl, SIOCBONDENSLAVE, &ifrm) < 0){
+			int rv=-errno;
+			D(SYSTEM, "Error enslaving %s to bond '%s'(idx %d): %s\n", dev->ifname, bond->ifname, bond->ifindex, strerror(-rv));
+			return rv;
+		}
+	}
+	if(!(ifrs.ifr_flags & IFF_UP)){
+		ifrs.ifr_flags |= IFF_UP;
+		if (ioctl(sock_ioctl, SIOCSIFFLAGS, &ifrs) < 0)
+			return -errno;
+	}
+
+	return 0;
+}
+
+int system_bond_delif(struct device *bond, struct device *dev){
+	struct nl_msg *msg;
+	struct ifinfomsg iim = { .ifi_family = AF_UNSPEC };
+	int rv;
+
+	msg = nlmsg_alloc_simple(RTM_NEWLINK, NLM_F_REQUEST);
+
+	if (!msg)
+		return -1;
+
+	nlmsg_append(msg, &iim, sizeof(iim), 0);
+	nla_put_string(msg, IFLA_IFNAME, dev->ifname);
+	nla_put_u32(msg, IFLA_MASTER, 0);
+	rv = system_rtnl_call(msg);
+	if(rv==-ENXIO) /* probably already exists */
+			rv=0;
+	else if (rv)
+		D(SYSTEM, "Error removing %s from bond '%s': %d\n", dev->ifname, bond->ifname, rv);
+
+	return rv;
+}
