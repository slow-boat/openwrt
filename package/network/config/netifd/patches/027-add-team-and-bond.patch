+int system_bond_add(struct device *bond, struct bond_config *cfg){
+	struct nl_msg *msg;
+	struct nlattr *linkinfo, *data;
+	struct ifinfomsg iim = { .ifi_family = AF_UNSPEC, };
+	int i, rv;
+	static const struct {
+		const char *name;
+		int val;
+	} modes[] = {
+		{ "balance-rr", BOND_MODE_ROUNDROBIN },
+		{ "active-backup", BOND_MODE_ACTIVEBACKUP },
+		{ "balance-xor", BOND_MODE_XOR },
+		{ "broadcast", BOND_MODE_BROADCAST },
+		{ "802.3ad", BOND_MODE_8023AD },
+		{ "balance-tlb", BOND_MODE_TLB },
+		{ "balance-alb", BOND_MODE_ALB }
+	};
+
+	msg = nlmsg_alloc_simple(RTM_NEWLINK, NLM_F_REQUEST | NLM_F_CREATE | NLM_F_EXCL);
+
+	if (!msg)
+		return -1;
+
+	nlmsg_append(msg, &iim, sizeof(iim), 0);
+
+	nla_put_string(msg, IFLA_IFNAME, bond->ifname);
+
+	if (!(linkinfo = nla_nest_start(msg, IFLA_LINKINFO)))
+		goto nla_put_failure;
+
+	nla_put_string(msg, IFLA_INFO_KIND, "bond");
+
+	if (!(data = nla_nest_start(msg, IFLA_INFO_DATA)))
+		goto nla_put_failure;
+
+	if (cfg->mode) {
+		for (i = 0; i < ARRAY_SIZE(modes); i++) {
+			if (strcmp(cfg->mode, modes[i].name) != 0)
+				continue;
+
+			nla_put_u32(msg, IFLA_BOND_MODE, modes[i].val);
+			break;
+		}
+	} else {
+		nla_put_u32(msg, IFLA_BOND_MODE, BOND_MODE_8023AD);
+	}
+
+	nla_nest_end(msg, data);
+	nla_nest_end(msg, linkinfo);
+
+	rv = system_rtnl_call(msg);
+	if(rv==-ENXIO) /* probably already exists */
+			rv=0;
+	else if (rv)
+		D(SYSTEM, "Error adding bond device '%s': %d\n", bond->ifname, rv);
+
+	return rv;
+
+nla_put_failure:
+	nlmsg_free(msg);
+	return -ENOMEM;
+}
