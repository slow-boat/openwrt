--- linux-5.10.27.orig/arch/arm64/boot/dts/rockchip/rk3308-rock-pi-s.dts
+++ linux-5.10.27/arch/arm64/boot/dts/rockchip/rk3308-rock-pi-s.dts
@@ -5,6 +5,7 @@
  */
 
 /dts-v1/;
+#include <dt-bindings/input/input.h>
 #include "rk3308.dtsi"
 
 / {
@@ -12,13 +13,13 @@
 	compatible = "radxa,rockpis", "rockchip,rk3308";
 
 	chosen {
-		stdout-path = "serial2:1500000n8";
+		stdout-path = "serial0:1500000n8";
 	};
 
 	leds {
 		compatible = "gpio-leds";
 		pinctrl-names = "default";
-		pinctrl-0 = <&green_led_gio>, <&heartbeat_led_gpio>;
+		pinctrl-0 = <&green_led_gpio>, <&heartbeat_led_gpio>;
 
 		green-led {
 			label = "rockpis:green:power";
@@ -30,11 +31,33 @@
 		blue-led {
 			label = "rockpis:blue:user";
 			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
-			default-state = "on";
 			linux,default-trigger = "heartbeat";
 		};
 	};
 
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&gpio_keys>;
+
+		button_1 {
+			debounce-interval = <20>;
+			gpios = <&gpio2 RK_PA7 GPIO_ACTIVE_LOW>;
+			label = "Button 1";
+			linux,code = <BTN_1>;
+		};
+	};
+
+	rotary1 {
+		compatible = "rotary-encoder";
+		pinctrl-names = "default";
+		pinctrl-0 = <&gpio_rotary_1>;
+		gpios = <&gpio1 RK_PC7 GPIO_ACTIVE_LOW>,
+					<&gpio1 RK_PC6 GPIO_ACTIVE_LOW>;
+		linux,axis = <1>; /* REL_Y */
+		rotary-encoder,relative-axis;
+	};
+
 	codec: acodec-sound {
 			compatible = "simple-audio-card";
 			simple-audio-card,format = "i2s";
@@ -150,7 +190,7 @@
 		vin-supply = <&vcc5v0_sys>;
 	};
 
-  vcc_phy: vcc-phy-regulator {
+	vcc_phy: vcc-phy-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "vcc_phy";
 		regulator-always-on;
@@ -245,17 +285,12 @@
 	#sound-dai-cells = <0>;
 };
 
-&spi2 {
-	status = "okay";
-	max-freq = <10000000>;
-};
-
 &pinctrl {
 	pinctrl-names = "default";
 	pinctrl-0 = <&rtc_32k>;
 
 	leds {
-		green_led_gio: green-led-gpio {
+		green_led_gpio: green-led-gpio {
 			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
 		};
 
@@ -281,6 +316,19 @@
 			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>;
 		};
 	};
+
+	keys {
+		gpio_keys: gpio-key-button-1 {
+			rockchip,pins = <2 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up_4ma>;
+		};
+	};
+
+	rotary {
+		gpio_rotary_1: gpio-rotary-1 {
+			rockchip,pins = <1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up_4ma>,
+					<1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up_4ma>;
+		};
+	};
 };
 
 &pwm0 {
@@ -326,10 +374,6 @@
 	status = "okay";
 };
 
