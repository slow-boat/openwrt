#!/bin/sh /etc/rc.common

START=50
STOP=99

edma_smp_affinity() {
	local nr=`cat /proc/cpuinfo | grep processor | wc -l`
	local cpu
	local n=2
	local irqs
	
	irqs=`grep edma_eth_tx /proc/interrupts | cut -d ':' -f 1 | tr -d ' '`
	irqs="$irqs `grep edma_eth_rx /proc/interrupts | cut -d ':' -f 1 | tr -d ' '`"
	irqs="$irqs `grep ath10k_a /proc/interrupts | cut -d ':' -f 1 | tr -d ' '`"
	
	echo "Setting affinity to single CPU for IRQs: "$irqs > /dev/kmsg
	for irq in $irqs; do
		cpu=`printf "%x" $((1<<(n%nr)))`
		n=$((n+1))
		echo $cpu > /proc/irq/$irq/smp_affinity
	done
}

boot() {
	edma_smp_affinity
}
