
config alsa
	option card 'rockchiprk3308a'
	option period_sz '1024'
	option periods '3'

config rtprio

config gpio
	option amp_gpio '16'
	option ovl_led 'rockpis:blue:user'

config crossover

config zita-n2j

config convolver
	option file 'RTA.wav'
	option partition '1024'
	option gain '0.25'

config mpd
	option smb_mount '1'
	option smb_args '-t cifs -o username=root,password=root,vers=1.0,sec=ntlm,file_mode=0777 //home-gateway/data/music'

