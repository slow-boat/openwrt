+						cfgroute->dynamic_metric_on=false;
+						cfgroute->enabled =false;
+					} else {
+						D(INTERFACE, "Old route metric %d on interface %s %s deleted\n", route->metric, passnode, iface->name);
 					}
+					if(!cfgroute->iface){
+						D(INTERFACE, "Linking interface %s %s to route\n", passnode, iface->name);
+						cfgroute->iface=iface;
