 }
 
+int system_ipvlan_add(struct device *ipvlan, struct device *dev, struct ipvlan_config *cfg)
+{
+	struct nl_msg *msg;
+	struct nlattr *linkinfo, *data;
+	struct ifinfomsg iim = { .ifi_family = AF_UNSPEC, };
+	int i, rv;
+	static const struct {
+		const char *name;
+		enum ipvlan_mode val;
+	} modes[] = {
+		{ "l2", IPVLAN_MODE_L2 },
+		{ "l3", IPVLAN_MODE_L3 },
+		{ "l3s", IPVLAN_MODE_L3S },
+	};
+
+	msg = nlmsg_alloc_simple(RTM_NEWLINK, NLM_F_REQUEST | NLM_F_CREATE | NLM_F_EXCL);
+
+	if (!msg)
+		return -1;
+
+	nlmsg_append(msg, &iim, sizeof(iim), 0);
+
+	nla_put_string(msg, IFLA_IFNAME, ipvlan->ifname);
+	nla_put_u32(msg, IFLA_LINK, dev->ifindex);
+
+	if (!(linkinfo = nla_nest_start(msg, IFLA_LINKINFO)))
+		goto nla_put_failure;
+
+	nla_put_string(msg, IFLA_INFO_KIND, "ipvlan");
+
+	if (!(data = nla_nest_start(msg, IFLA_INFO_DATA)))
+		goto nla_put_failure;
+
+	if (cfg->mode) {
+		for (i = 0; i < ARRAY_SIZE(modes); i++) {
+			if (strcmp(cfg->mode, modes[i].name) != 0)
+				continue;
+
+			nla_put_u32(msg, IFLA_IPVLAN_MODE, modes[i].val);
+			break;
+		}
+	} else {
+		nla_put_u32(msg, IFLA_IPVLAN_MODE, IPVLAN_MODE_L2);
+	}
+
+#ifdef IFLA_IPVLAN_FLAGS
+	static const struct {
+		const char *name;
+		enum ipvlan_flags val;
+	} flags[] = {
+		{ "bridge", 0 },
+		{ "private", IPVLAN_F_PRIVATE },
+		{ "vepa", IPVLAN_F_VEPA },
+	};
+
+	if (cfg->flags) {
+		for (i = 0; i < ARRAY_SIZE(flags); i++) {
+			if (strcmp(cfg->flags, flags[i].name) != 0)
+				continue;
+
+			nla_put_u32(msg, IFLA_IPVLAN_FLAGS, flags[i].val);
+			break;
+		}
+	}
+#endif
+
+	nla_nest_end(msg, data);
+	nla_nest_end(msg, linkinfo);
+
+	rv = system_rtnl_call(msg);
+	if (rv)
+		D(SYSTEM, "Error adding ipvlan '%s' over '%s': %d\n", ipvlan->ifname, dev->ifname, rv);
+
+	return rv;
+
+nla_put_failure:
+	nlmsg_free(msg);
+	return -ENOMEM;
+}
