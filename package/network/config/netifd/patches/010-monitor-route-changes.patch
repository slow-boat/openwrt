+/* override interface metric, and any route metrics */
+void
+interface_set_metric(int ifindex, struct device_route * route)
+{
+	struct interface *iface;
+
+	vlist_for_each_element(&interfaces, iface, node) {
+		struct device *dev= iface->l3_dev.dev;
+		if (dev && (dev->ifindex == ifindex)){
+			struct interface_ip_settings *ip=&iface->proto_ip;
+			int pass=0;
+			while(true) {
+				struct device_route *cfgroute;
+				vlist_for_each_element(&ip->route, cfgroute, node){
+					cfgroute->dynamic_metric_on=false;
+					if((cfgroute->addr.in.s_addr==route->addr.in.s_addr) &&
+						(cfgroute->nexthop.in.s_addr==route->nexthop.in.s_addr)){
+						if((cfgroute->enabled = route->enabled)){ /* disable if route deleted */
+							cfgroute->dynamic_metric_on=true;
+							cfgroute->dynamic_metric=route->metric;
+							D(INTERFACE, "Updating interface %s route metric to %d\n", iface->name, route->metric);
+						} else {
+							D(INTERFACE, "Disable interface %s route\n", iface->name);
+						}
+					}
+				}
+				if(pass++)break;
+				ip=&iface->config_ip;
+			}
+		}
+	}
+}
